local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", { Title = Hub, Text = text, Duration = 5 })
	end)
end

local current = Scripts[game.CreatorId]
if not current then
	notify("This game is not supported!")
	return
end

-- Skip only a duplicate run started within a few seconds (auto execute + the executor's autoexec
-- folder firing together). The old "true forever" flag blocked every later run, manual re-executes
-- included, after one failed attempt.
local G = getgenv()
if G.HinaHub_Executed and os.clock() - G.HinaHub_Executed < 20 then return end
G.HinaHub_Executed = os.clock()

G.HinaHub = {
	hub = Hub,
	discord = Discord_Invite,
	keyLink = Key_Link,
	premLink = KeyPrem_Link,
	workinkLink = Workink_Link,
	name = current.name,
	script_id = current.script_id,
}

-- A failed download or key system error clears the flag so the next run is not blocked.
-- Errors inside the obfuscated key system / Luarmor loader (e.g. "Luraph Script:61: ...
-- attempt to perform arithmetic (mul)", seen on mobile) are usually a bad download: retry
-- the whole chain twice with a fresh download before telling the player.
local ok, err
for attempt = 1, 3 do
	ok, err = pcall(function()
		local src
		for i = 1, 3 do
			local got, body = pcall(game.HttpGet, game, UI_LOADER)
			if got and type(body) == "string" and #body > 0 then src = body break end
			task.wait(i)
		end
		assert(src, "could not download the key system")
		assert(loadstring(src))()
	end)
	if ok then break end
	task.wait(attempt * 3)
end
if not ok then
	G.HinaHub_Executed = nil
	notify("Failed to load, run the script again. (" .. tostring(err) .. ")")
end
